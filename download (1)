import {Locator, Page} from "@playwright/test";

enum WidgetPageSelectors {
    WIDGET_BODY = '[class^=widgetWrapper] > [class^=widget__]',
    HEADER_TEXT = 'header h5',
    BUTTON_OPEN = '[data-test=openWidget]',
    BUTTON_WRITE_TO_US = '[class^=btn]',
    ARTICLE_POPULAR_TITLE = '[class^=popularTitle__]',
    ARTICLE_POPULAR_LIST = `${ARTICLE_POPULAR_TITLE} + ul[class^=articles__]`,
    ARTICLE_POPULAR_LIST_ITEM = `${ARTICLE_POPULAR_LIST} > li`,
}

export class WidgetPage {
    static selector = WidgetPageSelectors;

    constructor(protected page: Page) {}

    // виджет ищем по всей странице: старый корневой селектор (.sc-dino-typography-h > ...) не находил элементы
    wrapper(): Page {
        return this.page;
    }

    async openWidget() {
        await this.wrapper().locator(WidgetPage.selector.BUTTON_OPEN).click();
        await this.getWidgetBody().waitFor({state: 'visible'});
    }

    async getPopularArticles(): Promise<Locator[]> {
        const items = this.getWidgetBody().locator(WidgetPage.selector.ARTICLE_POPULAR_LIST_ITEM);
        // all() не ждёт загрузки списка — без ожидания возвращался пустой массив
        await items.first().waitFor({state: 'visible'});
        return items.all();
    }

    async clickWriteToUs() {
        // под селектор [class^=btn] попадает несколько кнопок — strict mode violation
        await this.getWidgetBody().locator(WidgetPage.selector.BUTTON_WRITE_TO_US).first().click();
    }

    getTitle(): Locator {
        return this.getWidgetBody().locator(WidgetPage.selector.HEADER_TEXT).first();
    }

    getWidgetBody(): Locator {
        return this.page.locator(WidgetPage.selector.WIDGET_BODY);
    }
}
